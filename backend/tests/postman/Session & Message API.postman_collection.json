    {
      "name": "3. Get Chat History",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "const messages = json.data;",
              "",
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('status is success and data is a non-empty array', function () {",
              "    pm.expect(json.status).to.eql('success');",
              "    pm.expect(messages).to.be.an('array').that.is.not.empty;",
              "});",
              "",
              "pm.test('Each message has the correct structure', function () {",
              "    messages.forEach(function (m) {",
              "        pm.expect(m).to.have.all.keys('id', 'session_id', 'sender', 'content', 'created_at');",
              "        pm.expect(m.id).to.be.a('number');",
              "        pm.expect(m.session_id).to.eql(pm.collectionVariables.get('sessionId'));",
              "        pm.expect(m.sender).to.be.oneOf(['user', 'bot']);",
              "        pm.expect(m.content).to.be.a('string');",
              "        pm.expect(new Date(m.created_at).toString()).to.not.eql('Invalid Date');",
              "    });",
              "});",
              "",
              "pm.test('Messages are ordered by created_at ascending', function () {",
              "    for (let i = 1; i < messages.length; i++) {",
              "        pm.expect(new Date(messages[i].created_at).getTime())",
              "            .to.be.at.least(new Date(messages[i - 1].created_at).getTime());",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sessions",
            "{{sessionId}}",
            "messages"
          ]
        }
      },
      "response": []
    }
