  "item": [
    {
      "name": "1. Create Session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "const id = json.data && json.data.id;",
              "",
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response time < 1000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "",
              "pm.test('status is success', function () {",
              "    pm.expect(json.status).to.eql('success');",
              "});",
              "",
              "pm.test('Session ID is a valid UUID', function () {",
              "    pm.expect(id, 'session id').to.be.a('string');",
              "    pm.expect(id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
              "});",
              "",
              "// Save session ID for the following requests",
              "if (id) {",
              "    pm.collectionVariables.set('sessionId', id);",
              "    pm.environment.set('sessionId', id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/sessions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sessions"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2a. Send Message - Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response contains the saved message', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.status).to.eql('success');",
              "    pm.expect(json.data).to.have.property('id');",
              "    pm.expect(json.data.session_id).to.eql(pm.collectionVariables.get('sessionId'));",
              "    pm.expect(json.data.sender).to.eql('user');",
              "    pm.expect(json.data.content).to.eql('Hello, I need help');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sender\": \"user\",\n  \"content\": \"Hello, I need help\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sessions",
            "{{sessionId}}",
            "messages"
          ]
        }
      },
      "response": []
    },
